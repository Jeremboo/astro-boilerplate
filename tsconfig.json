{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "target": "es5",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": "./src",
    "types": ["vite-plugin-glsl/ext"],
    "lib": ["ES2021.String"],
    "paths": {
      "~assets/*": ["assets/*"],
      "~components/*": ["components/*"],
      "~data/*": ["data/*"],
      "~hooks/*": ["hooks/*"],
      "~layouts/*": ["layouts/*"],
      "~pages/*": ["pages/*"],
      "~store/*": ["store/*"],
      "~styles/*": ["styles/*"],
      "~types/*": ["types/*"],
      "~utils/*": ["utils/*"],
      "~webgl/*": ["webgl/*"]
    }
  }
}
