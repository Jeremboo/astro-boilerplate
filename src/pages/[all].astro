---
import type { GetStaticPaths, GetStaticPathsResult } from 'astro';

import { ROUTES_SPA } from '~data/routing';
import Index from './index.astro';

// Array of all ROUTES who will be in my SPA
export const getStaticPaths = (() =>
  Object.values(ROUTES_SPA).reduce((acc, { path }) => {
    if (path != import.meta.env.BASE_URL) {
      acc.push({ params: { all: path } });
    }
    return acc;
  }, [] as GetStaticPathsResult)) satisfies GetStaticPaths;
---

<Index />
