---
import Container from '~components/Container.astro';
import Layout from '~layouts/Layout.astro';
import Nav from '~spa/components/Nav';
import { Languages } from '~types/enum';

interface Props {
  lang?: Languages;
}

const { lang = Languages.en } = Astro.props;
---

<Layout lang={lang}>
  <Container>
    <h2>Blog</h2>
    <Nav client:load />
  </Container>
</Layout>
