---
import LayoutStatic from '~layouts/LayoutStatic.astro';
import Nav from '~spa/components/Nav';
import { Languages } from '~types/enum';

interface Props {
  lang?: Languages;
}

const { lang = Languages.en } = Astro.props;
---

<LayoutStatic lang={lang}>
  <h2>Blog</h2>
  <Nav client:load />
</LayoutStatic>
